# --- Server (Pusher server SDK pointed at self-hosted Sockudo) ---
PUSHER_APP_ID=livechat
PUSHER_KEY=livechat-key
PUSHER_SECRET=change-me-in-production
# Self-hosted host instead of a Pusher cluster:
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_USE_TLS=false

# --- Client (pusher-js pointed at the same server) ---
NEXT_PUBLIC_PUSHER_KEY=livechat-key
NEXT_PUBLIC_PUSHER_HOST=127.0.0.1
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_FORCE_TLS=false
