{
  "//": "Minimal Sockudo config for livechat-bridge. Replace the app credentials",
  "//key": "and confirm field names against https://sockudo.io (they may evolve).",
  "port": 6001,
  "host": "0.0.0.0",
  "app_manager": {
    "driver": "array",
    "array": {
      "apps": [
        {
          "id": "livechat",
          "key": "livechat-key",
          "secret": "change-me-in-production",
          "max_connections": 10000,
          "enable_client_messages": true
        }
      ]
    }
  },
  "adapter": {
    "driver": "redis",
    "redis": {
      "url": "redis://redis:6379"
    }
  }
}
