{
  "name": "livechat-bridge",
  "version": "0.3.0",
  "description": "Embeddable multi-site live chat: a React widget for visitors, an agent inbox for staff, and Mongoose-backed route handlers. WebSocket-first with HTTP long-poll fallback, anonymous visitors, and siteId tenant isolation.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Hossain Billal",
    "url": "https://next-portfolio-ruby-nine.vercel.app/"
  },
  "homepage": "https://github.com/proffesergio/livechat-bridge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/proffesergio/livechat-bridge.git"
  },
  "keywords": [
    "live-chat",
    "customer-support",
    "chat-widget",
    "embeddable",
    "multi-tenant",
    "websocket",
    "long-polling",
    "anthropic",
    "claude",
    "ai-fallback",
    "nextjs",
    "react",
    "mongoose",
    "agent-inbox",
    "helpdesk"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "require": "./dist/widget/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.cjs"
    },
    "./widget.css": "./dist/widget/widget.css",
    "./admin.css": "./dist/admin/admin.css",
    "./widget/widget.css": "./dist/widget/widget.css",
    "./admin/admin.css": "./dist/admin/admin.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:link-atharnur": "node scripts/dev-link-atharnur.mjs",
    "prepublishOnly": "tsup && vitest run"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.32.0",
    "mongoose": "^8.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.7.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server"
    ]
  }
}
